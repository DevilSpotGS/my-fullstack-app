# ไฟล์นี้ใช้กับ docker compose
# วิธีใช้: คัดลอกไฟล์นี้เป็นชื่อ .env แล้วเปลี่ยนรหัสผ่านเป็นของคุณเอง

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_app

# พอร์ตที่เปิดออกมาที่เครื่องคุณ (ถ้าในเครื่องมี MySQL ใช้ 3306 อยู่แล้ว ให้เปลี่ยนเป็น 3307)
MYSQL_PORT=3306

# ---------- Backend / Frontend ----------
BACKEND_PORT=4000
FRONTEND_PORT=3000

# URL ที่ "เบราว์เซอร์" ใช้เรียก API (เบราว์เซอร์อยู่นอก Docker จึงใช้ localhost)
NEXT_PUBLIC_API_URL=http://localhost:4000
