{
  "name": "my-fullstack-app",
  "private": true,
  "description": "Next.js (frontend) + Express (backend) + TypeScript + MySQL + Docker",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.7"
  }
}
