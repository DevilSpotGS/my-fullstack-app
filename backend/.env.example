# ไฟล์นี้ใช้ตอนรัน backend ในเครื่อง (npm run dev) ไม่ใช่ใน Docker
# วิธีใช้: คัดลอกเป็น backend/.env แล้วใส่รหัสผ่านให้ตรงกับไฟล์ .env ที่โฟลเดอร์หลัก

PORT=4000

# ตอนรันในเครื่อง MySQL (ใน Docker) ถูกเปิดออกมาที่ localhost
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=change_me_app
DB_NAME=app_db

# หน้าเว็บที่อนุญาตให้เรียก API นี้
CORS_ORIGIN=http://localhost:3000
